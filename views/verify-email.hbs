<html>
  <head>
    <meta charset='utf-8' />
    <title>NestAuth</title>
  </head>
  <body>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: sans-serif;
      }
      .message {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        text-align: center;
      }
    </style>
    <div class='message'>
      <h1>{{status}}</h1>
    </div>
  </body>
</html>